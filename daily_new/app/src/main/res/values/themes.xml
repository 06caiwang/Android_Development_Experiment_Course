<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 统一使用浅色主题，避免深色模式下界面变色 -->
    <style name="Base.Theme.Daily_new" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorSecondary">@color/brand_red</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.Daily_new" parent="Base.Theme.Daily_new" />
</resources>
