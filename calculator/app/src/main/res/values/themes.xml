<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 计算器固定使用浅色主题：硬编码的浅色界面在深色模式下会失真 -->
    <style name="Base.Theme.Calculator" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@color/bg_page</item>
        <item name="android:navigationBarColor">@color/bg_page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">@color/accent</item>
    </style>

    <style name="Theme.Calculator" parent="Base.Theme.Calculator" />
</resources>
