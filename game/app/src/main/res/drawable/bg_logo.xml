<?xml version="1.0" encoding="utf-8"?>
<!-- 游戏 Logo 底板：橙色渐变圆角方块 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="34dp" />
    <gradient
        android:angle="315"
        android:centerColor="#FFB020"
        android:endColor="#EE8A00"
        android:startColor="#FFD37A"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#55FFFFFF" />
</shape>
