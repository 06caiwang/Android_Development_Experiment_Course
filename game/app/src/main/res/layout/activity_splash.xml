<?xml version="1.0" encoding="utf-8"?>
<!--
    游戏开始界面（启动页）
    布局思路：FrameLayout 作为根容器承载全屏渐变背景，
    内部使用竖向 LinearLayout + layout_weight 让 Logo 区垂直居中、按钮区贴底。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="26dp">

        <!-- 上半部分留白，把中间内容顶到视觉中心 -->
        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ============ Logo ============ -->
        <FrameLayout
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:background="@drawable/bg_logo"
            android:elevation="12dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_tank"
                app:tint="@color/ink" />
        </FrameLayout>

        <!-- ============ 游戏名 ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.14"
            android:shadowColor="#66FFB020"
            android:shadowDy="0"
            android:shadowRadius="24"
            android:text="@string/splash_title"
            android:textColor="@color/text_primary"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.5"
            android:text="@string/splash_subtitle"
            android:textColor="@color/amber"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 分隔线 -->
        <View
            android:layout_width="46dp"
            android:layout_height="3dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.08"
            android:text="@string/splash_tagline"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- 下半部分留白，把按钮区压到屏幕底部 -->
        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ============ 开始游戏 ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.02"
            android:text="@string/splash_notice"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            style="@style/Widget.Game.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/splash_start" />

        <!-- ============ 次级入口 ============ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnAbout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="@string/splash_about"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:background="@color/outline" />

            <TextView
                android:id="@+id/btnExit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="@string/splash_exit"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/splash_version"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
