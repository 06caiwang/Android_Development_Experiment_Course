   "block": "paragraph",
   "calls": [
    {
     "tool": "doc_insert_paragraph_with_text",
     "args": {
      "text": "三个页面分别对应 MainActivity（activity_splash.xml）、TermsActivity（activity_terms.xml）和 GameActivity（activity_game.xml）。“开始游戏”按钮通过 startActivity(new Intent(this, TermsActivity.class)) 跳转到条款页；“同意并开始”按钮在跳转到游戏界面后调用 finish() 结束条款页，因此从游戏界面按返回键会直接回到开始界面，而不会再次停在条款页。",
      "text_format": {
       "font_family": "宋体",
       "font_size": 12
      },
      "paragraph_property": {
       "jc": "both",
       "line_spacing": 1.3,
