       "spacing_before": 0,
       "spacing_after": 0
      }
     }
    },
    {
     "tool": "doc_modify_paragraph",
     "args": {
      "first_line_indent_chars": 2
     }
    }
   ]
  },
  {
   "block": "paragraph",
   "calls": [
    {
     "tool": "doc_insert_paragraph_with_text",
     "args": {
